{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default-standard",
  "description": "Default permissions for the standard Android edition",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-create",
    "updater:default",
    "android-updater:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*.*.*.*:*/*" },
        { "url": "https://*.*.*.*:*/*" },
        { "url": "http://localhost:*/*" },
        { "url": "https://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "https://127.0.0.1:*/*" }
      ]
    },
    "process:default"
  ]
}
